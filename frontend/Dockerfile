FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.29.2 --activate

ARG VITE_AUTH_URL
ARG VITE_REPORTES_URL
ARG VITE_RESTAURANTES_URL
ARG VITE_MESAS_URL
ARG VITE_PEDIDOS_URL
ARG VITE_RESERVACIONES_URL
ARG VITE_CLOUDINARY_BASE_URL

ENV VITE_AUTH_URL=$VITE_AUTH_URL
ENV VITE_REPORTES_URL=$VITE_REPORTES_URL
ENV VITE_RESTAURANTES_URL=$VITE_RESTAURANTES_URL
ENV VITE_MESAS_URL=$VITE_MESAS_URL
ENV VITE_PEDIDOS_URL=$VITE_PEDIDOS_URL
ENV VITE_RESERVACIONES_URL=$VITE_RESERVACIONES_URL
ENV VITE_CLOUDINARY_BASE_URL=$VITE_CLOUDINARY_BASE_URL

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
